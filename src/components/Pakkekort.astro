---
import type { CollectionEntry } from "astro:content";
import { dato, moter } from "../lib/format";
interface Props { pakke: CollectionEntry<"pakker"> }
const { pakke } = Astro.props;
const d = pakke.data;
const utv = d.status !== "Klar";
---
<li
  data-fag={d.fagomrade}
  data-status={d.status}
  data-dato={d.sist_oppdatert.toISOString().slice(0, 10)}
  data-tittel={d.tittel}
  data-fremhevet={d.fremhevet ? "1" : "0"}
  data-tekst={`${d.tittel} ${d.sammendrag} ${d.fagomrade}`.toLowerCase()}
>
  <article class:list={["pakkekort", { utv }]}>
    <h3><a href={`/pakker/${d.slug}/`}>{d.tittel}</a></h3>
    <p>{d.sammendrag}</p>
    <div class="nederst">
      <div class="fakta-liten">
        <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{d.tidsbruk}</span>
        <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="8" cy="9" r="3"/><circle cx="16" cy="9" r="3"/><circle cx="12" cy="16" r="3"/></svg>{moter(d.antall_moter)}</span>
      </div>
      <div class="chips">
        <span class="chip"><span class="sr-only">Fagområde: </span>{d.fagomrade}</span>
        <span class:list={["status", utv ? "utv" : "klar"]}><span class="sr-only">Status: </span>{d.status}</span>
      </div>
      <span class="oppdatert">Oppdatert {dato(d.sist_oppdatert)}</span>
    </div>
  </article>
</li>
